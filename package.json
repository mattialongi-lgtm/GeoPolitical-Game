{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx --watch backend/app.ts\" \"vite\"",
    "dev:backend": "tsx --watch backend/app.ts",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --watch",
    "test:security-hardening": "node scripts/security-hardening-regression-smoke.cjs",
    "test:security-db-integration": "node scripts/security-db-integration.mjs",
    "test:security-atomic-actions": "node scripts/security-atomic-actions-integration.mjs",
    "test:security-db-integration:ci": "node -e \"process.env.REQUIRE_DB_INTEGRATION='true'; process.env.RUN_DB_INTEGRATION_TESTS='true'; import('./scripts/security-db-integration.mjs')\"",
    "test:security-db-rls-validation": "node scripts/security-db-rls-validation.mjs",
    "test:security-db-rls-validation:ci": "node -e \"process.env.REQUIRE_DB_RLS_VALIDATION='true'; process.env.RUN_DB_RLS_VALIDATION_TESTS='true'; import('./scripts/security-db-rls-validation.mjs')\"",
    "test:security-db-rls-validation:backend": "node -e \"process.env.RUN_BACKEND_FLOW_VALIDATION='true'; import('./scripts/security-db-rls-validation.mjs')\"",
    "test:security-db-rls-validation:backend:ci": "node -e \"process.env.REQUIRE_DB_RLS_VALIDATION='true'; process.env.RUN_DB_RLS_VALIDATION_TESTS='true'; process.env.REQUIRE_BACKEND_FLOW_VALIDATION='true'; process.env.RUN_BACKEND_FLOW_VALIDATION='true'; import('./scripts/security-db-rls-validation.mjs')\"",
    "check:hardening": "tsc -p tsconfig.hardening.json && node scripts/write-hardening-package-json.cjs && node .hardening-dist/scripts/hardening-contract-smoke.js && node .hardening-dist/scripts/factory-deposit-hardening-smoke.js && node .hardening-dist/scripts/factory-upgrade-hardening-smoke.js && node .hardening-dist/scripts/factory-create-hardening-smoke.js && node .hardening-dist/scripts/party-assets-hardening-smoke.js && node .hardening-dist/scripts/production-hardening-smoke.js && node .hardening-dist/scripts/production-repository-hardening-smoke.js && node .hardening-dist/scripts/daily-reward-hardening-smoke.js && node .hardening-dist/scripts/war-deploy-hardening-smoke.js",
    "test:security-economic-cooldown-surface": "node scripts/security-economic-cooldown-surface.cjs",
    "verify:war-rls": "node scripts/verify-war-tables-rls.mjs",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.35.0",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "react-simple-maps": "^3.0.0",
    "resolve-pkg-maps": "^1.0.0",
    "tailwind-merge": "^3.5.0",
    "topojson-client": "^3.1.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
